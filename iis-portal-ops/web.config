<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <authorization>
        <clear />
        <add accessType="Allow" roles="GRATITUDE\ImpressaoOPs-Operacao" />
      </authorization>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="100000" />
      </requestFiltering>
    </security>
    <handlers accessPolicy="Execute">
      <clear />
      <add name="PortalOps" path="*" verb="GET,POST"
           modules="CgiModule" resourceType="Unspecified" requireAccess="Execute"
           scriptProcessor="C:\Nunes\ImpressaoOpsPortal\gateway\PortalOps.exe" />
    </handlers>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
